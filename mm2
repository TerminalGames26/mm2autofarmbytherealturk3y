--====================== COIN SCANNING ======================
local function scan()
local coins, hasContainer = {}, false
for _, d in ipairs(Workspace:GetDescendants()) do
if d.Name == "CoinContainer" then
hasContainer = true
elseif d:IsA("BasePart") and d.Name == "Coin_Server" then
local p = d.Parent
if p and p.Name == "CoinContainer" and d:FindFirstChild("TouchInterest") then
coins[#coins + 1] = d
end
end
end
return coins, hasContainer
end

--======================== LOBBY CHECK ======================
local lobbyModel, lobbyParts, lobbyScanAt = nil, {}, 0

local function refreshLobby(force)
if not force and os.clock() - lobbyScanAt < 2 then return end
lobbyScanAt = os.clock()

lobbyModel = Workspace:FindFirstChild(LOBBY_NAME)
if not lobbyModel or not lobbyModel:IsA("Model") then
lobbyModel = nil
for _, d in ipairs(Workspace:GetDescendants()) do
if d:IsA("Model") and d.Name == LOBBY_NAME then
lobbyModel = d
break
end
end
end

lobbyParts = {}
if lobbyModel then
for _, p in ipairs(lobbyModel:GetDescendants()) do
if p:IsA("BasePart") then
lobbyParts[#lobbyParts + 1] = p
end
end
end
end

local function inLobby()
if lobbyModel and not lobbyModel.Parent then
refreshLobby(true)
else
refreshLobby(false)
end
if not lobbyModel or not Root then return false end

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.FilterDescendantsInstances = { Char }
params.IgnoreWater = true

local hit = Workspace:Raycast(Root.Position, Vector3.new(0, -14, 0), params)
if hit and hit.Instance then
local a = hit.Instance
while a and a ~= Workspace do
if a == lobbyModel then return true end
a = a.Parent
end
end

local ok, cf, size = pcall(function() return lobbyModel:GetBoundingBox() end)
if ok and cf and size then
local lp = cf:PointToObjectSpace(Root.Position)
if math.abs(lp.X) <= size.X / 2 + 4
and math.abs(lp.Z) <= size.Z / 2 + 4
and math.abs(lp.Y) <= size.Y / 2 + 8 then
return true
end
end

local pos = Root.Position
for _, p in ipairs(lobbyParts) do
local rel = p.CFrame:PointToObjectSpace(pos)
local half = p.Size * 0.5
local cl = Vector3.new(
math.clamp(rel.X, -half.X, half.X),
math.clamp(rel.Y, -half.Y, half.Y),
math.clamp(rel.Z, -half.Z, half.Z)
)
if (p.CFrame:PointToWorldSpace(cl) - pos).Magnitude <= 4 then
return true
end
end

return false
end

--================= NOCLIP (always on) ======================
local function applyNoclip(on)
if not Char then return end
if on then
for _, p in ipairs(Char:GetDescendants()) do
if p:IsA("BasePart") then
if noclipSaved[p] == nil then
noclipSaved[p] = p.CanCollide
end
p.CanCollide = false
end
end
else
for p, orig in pairs(noclipSaved) do
if p and p.Parent then
p.CanCollide = orig
p.CanTouch = true
end
end
noclipSaved = {}
end
end

