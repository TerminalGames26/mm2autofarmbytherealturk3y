local function prepCoin(coin)
pcall(function() coin.CanTouch = true end)
end

local function proneRotation(dir)
local d = Vector3.new(dir.X, 0, dir.Z)
if d.Magnitude < 0.001 then d = Vector3.new(0, 0, -1) end
return CFrame.lookAt(Vector3.zero, Vector3.new(0, -1, 0), d.Unit).Rotation
end

--========================= FLY TO ==========================
local function flyTo(coin, timeout)
timeout = timeout or 12
local startT = os.clock()
local arrived = false
local arrivedAt = nil
local side = 1
local lastSwap = 0
local lastCheck = 0

touchMode = false
setFlying(true)

local D = Vector3.new(
coin.Position.X - Root.Position.X, 0,
coin.Position.Z - Root.Position.Z
)
if D.Magnitude < 0.05 then D = Vector3.new(0, 0, -1) end
D = D.Unit

local flatRot = proneRotation(D)

while State.AutoFarm do
if not coin or not coin.Parent or not coin:FindFirstChild("TouchInterest") then
touchMode = false
return true
end
if os.clock() - startT > timeout then
touchMode = false
return false
end
if not Root or not Hum or Hum.Health <= 0 then
touchMode = false
return false
end

local dt = RunService.Heartbeat:Wait()
local target = coin.Position + Vector3.new(0, State.Hover, 0)
local pos = Root.Position
local dir = target - pos
local dist = dir.Magnitude

if not arrived then
if dist <= TOUCH_DIST then
arrived = true
arrivedAt = os.clock()
touchMode = true
prepCoin(coin)
setFlying(false)
Hum.AutoRotate = true
Hum.WalkSpeed = WALK_SPEED
Root.CFrame = CFrame.lookAt(target, target + D)
lastSwap = os.clock()
Hum:MoveTo(coin.Position + D * PATROL_SPAN)
else
local step = math.min(State.Speed * dt, dist)
Root.CFrame = CFrame.new(pos + dir.Unit * step) * flatRot
end
else
if os.clock() - lastSwap > PATROL_SWAP then
lastSwap = os.clock()
side = -side
Hum:MoveTo(coin.Position + D * (PATROL_SPAN * side))
end

if os.clock() - lastCheck > 0.5 then
lastCheck = os.clock()
local flatNow = Vector3.new(Root.Position.X, 0, Root.Position.Z)
local flatC = Vector3.new(coin.Position.X, 0, coin.Position.Z)
if (flatNow - flatC).Magnitude > PATROL_SPAN * 2.5 then
Root.CFrame = CFrame.new(target) * Root.CFrame.Rotation
Hum:MoveTo(coin.Position + D * PATROL_SPAN)
end
end

if os.clock() - arrivedAt > GIVE_UP then
touchMode = false
return false
end
end
end

touchMode = false
return true
end

--===================== RESET TO LOBBY ======================
local function resetToLobby()
local oldChar = Char

setStatus("Resetting...")
touchMode = false
setFlying(false)
State.AutoFarm = false
refresh()

if Hum and Hum.Health > 0 then
Hum.Health = 0
end

-- give it a moment, then force it if the game didn't kill us
local t0 = os.clock()
while Char == oldChar and os.clock() - t0 < 1.5 do
task.wait(0.1)
end
if Char == oldChar and Char and Char.Parent then
pcall(function() Char:BreakJoints() end)
end

-- wait for the new character to land in the lobby
local t1 = os.clock()
while Char == oldChar and os.clock() - t1 < 6 do
task.wait(0.1)
end

setStatus("Idle")
end

--========================= FARM LOOP =========================
local farmActive = false

local function startFarm()
if farmActive then return end
farmActive = true

task.spawn(function()
local emptySince = nil

while State.AutoFarm do
if not Root or not Hum or Hum.Health <= 0 then
setStatus("Waiting for character...")
task.wait(0.25)
continue
end

if inLobby() then
setFlying(false)
setStatus("In Lobby · paused")
task.wait(0.25)
continue
end

local coins, hasContainer = scan()

if #coins == 0 then
emptySince = emptySince or os.clock()

if os.clock() - emptySince > DONE_WAIT then
resetToLobby()
break
end

setStatus(hasContainer and "Waiting for coins..." or "Finishing up...")
task.wait(0.3)
continue
end

emptySince = nil

table.sort(coins, function(a, b)
return (a.Position - Root.Position).Magnitude
< (b.Position - Root.Position).Magnitude
end)

for i, coin in ipairs(coins) do
if not State.AutoFarm then break end
if coin.Parent and coin:FindFirstChild("TouchInterest") then
setStatus(("Collecting %d / %d"):format(i, #coins))
flyTo(coin)
task.wait(0.05)
end
end
end

farmActive = false
touchMode = false
setFlying(false)
setStatus("Idle")
refresh()
end)
end

